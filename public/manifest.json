{
  "manifest_version": 3,
  "name": "Markdown Reader",
  "version": "0.3.0",
  "description": "隐私优先的 Markdown 阅读器：本地与在线 .md 直接渲染，左侧文件树、右侧大纲。",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "file:///*",
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "file:///*",
        "*://*/*.md",
        "*://*/*.markdown",
        "*://*/*.mkd",
        "*://*/*.mdx"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Markdown Reader",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "mermaid-frame.html",
        "mermaid-frame*.js",
        "mermaid-frame*.css"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
